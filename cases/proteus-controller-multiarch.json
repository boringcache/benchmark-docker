    "evidence_run": "https://github.com/CraftingTech/proteus/actions/runs/30160511674",
    "runner": "GitHub-hosted ubuntu-24.04"
  },
  "refs": {
    "main": "71ac73a73c99bdc97fa88878ffc9474d589fa668",
    "rolling1": "b3d6345e08cd5c77eae2e06ed97c2eeeed89e1a9",
